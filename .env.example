# Docker / image settings
IMAGE_REPOSITORY_OWNER=your-github-username
IMAGE_TAG=latest

# Core platform
DB_USERNAME=medibook_user
DB_PASSWORD=medibook_pass
MYSQL_ROOT_PASSWORD=medibook_root_pass
MYSQL_PORT=3307
JWT_SECRET=MediBookSuperSecretKey2024MustBeAtLeast256BitsLong!!
JWT_EXPIRATION=86400000
EUREKA_USERNAME=admin
EUREKA_PASSWORD=medibook123
EUREKA_DEFAULT_ZONE=http://admin:medibook123@eureka-server:8761/eureka/
BOOT_ADMIN_URL=http://eureka-server:8761
BOOT_ADMIN_USERNAME=admin
BOOT_ADMIN_PASSWORD=medibook123

# Gateway / frontend
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_RAZORPAY_KEY=
GATEWAY_ALLOWED_ORIGIN_PATTERN_1=http://localhost:[*]
GATEWAY_ALLOWED_ORIGIN_PATTERN_2=http://127.0.0.1:[*]
GATEWAY_ALLOWED_ORIGIN_PATTERN_3=http://*.nip.io:[*]
GATEWAY_ALLOWED_ORIGIN_PATTERN_4=https://*.nip.io:[*]

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Mail / OAuth / payment
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_API_KEY=
RAZORPAY_KEY_SECRET=

# Admin bootstrap
ADMIN_SECRET_CODE=AdminSecret2024!
ADMIN_PASSWORD_1=ChangeMeAdmin#1
ADMIN_PASSWORD_2=ChangeMeAdmin#2

# SonarQube tool stack
SONARQUBE_JDBC_USERNAME=sonarqube
SONARQUBE_JDBC_PASSWORD=sonarqube
SONARQUBE_JDBC_DATABASE=sonarqube
